@using QuickPay.BLL.DTOs.PaymentGateway
@model IEnumerable<BankAccountDto>

@{
    ViewData["Title"] = "Linked Accounts";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6">

            <h2 class="mb-4">Linked Accounts</h2>

            @if (TempData["SuccessMessage"] is not null)
            {
                <div class="alert alert-success">@TempData["SuccessMessage"]</div>
            }
            @if (TempData["ErrorMessage"] is not null)
            {
                <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
            }

            <div class="list-group mb-4">
                @foreach (var account in Model)
                {
                    <div class="list-group-item d-flex justify-content-between align-items-center">
                        <div>
                            <div class="fw-semibold">@account.DisplayName</div>
                            <small class="text-muted">@account.MaskedNumber</small>
                        </div>
                        <form asp-action="Unlink" asp-controller="LinkedAccounts" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@account.Id" />
                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                Remove
                            </button>
                        </form>
                    </div>
                }
            </div>

            <div class="card shadow-sm border-0">
                <div class="card-body p-4">
                    <h5 class="mb-3">Link a New Card</h5>

                    <p class="text-muted small">
                        You'll be redirected to a secure checkout to verify your
                        card with a small refundable charge (1.00 EGP). We never
                        see or store your card number - only the token the
                        gateway gives back.
                    </p>

                    <form asp-action="LinkStart" asp-controller="LinkedAccounts" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-primary w-100">
                            Link New Card
                        </button>
                    </form>
                </div>
            </div>

        </div>
    </div>
</div>
