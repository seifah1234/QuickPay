@using QuickPay.BLL.DTOs
@model IEnumerable<NotificationDto>

@{
    ViewData["Title"] = "Notifications";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-7">

            <h2 class="mb-4">Notifications</h2>

            @if (!Model.Any())
            {
                <p class="text-muted">No notifications yet.</p>
            }

            <div class="list-group">
                @foreach (var notification in Model)
                {
                    <div class="list-group-item @(notification.IsRead ? "" : "list-group-item-primary")">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <div class="fw-semibold">@notification.Type</div>
                                <div>@notification.Message</div>
                                <small class="text-muted">
                                    @notification.CreatedAt.ToString("g")
                                </small>
                            </div>

                            @if (!notification.IsRead)
                            {
                                <form asp-action="MarkAsRead" asp-controller="Notifications" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@notification.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-secondary">
                                        Mark as read
                                    </button>
                                </form>
                            }
                        </div>
                    </div>
                }
            </div>

        </div>
    </div>
</div>

@section Scripts
{
    <script src="~/js/notifications-live.js"></script>
}
