@using QuickPay.BLL.ViewModels
@model WalletIndexViewModel

@{
    ViewData["Title"] = "My Wallets";
}

<div class="container py-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <div>
            <h1 class="qp-dashboard-title mb-1">My Wallets</h1>
            <p class="text-muted mb-0">Manage your wallets, deposit and withdraw funds.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Deposit" asp-controller="PaymentGateway" class="btn btn-success">
                <svg width="16" height="16" fill="currentColor" viewBox="0 0 16 16" class="me-2">
                    <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14zm0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16z" />
                    <path d="M8 4a.5.5 0 0 1 .5.5v3h3a.5.5 0 0 1 0 1h-3v3a.5.5 0 0 1-1 0v-3h-3a.5.5 0 0 1 0-1h3v-3A.5.5 0 0 1 8 4z" />
                </svg>
                Deposit
            </a>
            <a asp-action="Withdraw" asp-controller="PaymentGateway" class="btn btn-warning">
                <svg width="16" height="16" fill="currentColor" viewBox="0 0 16 16" class="me-2">
                    <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14zm0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16z" />
                    <path d="M4 8a.5.5 0 0 1 .5-.5h7a.5.5 0 0 1 0 1h-7A.5.5 0 0 1 4 8z" />
                </svg>
                Withdraw
            </a>
        </div>
    </div>

    <!-- Alerts -->
    @if (TempData["SuccessMessage"] is not null)
    {
        <div class="alert alert-success d-flex align-items-center mb-4" role="alert">
            <svg width="18" height="18" fill="currentColor" viewBox="0 0 16 16" class="me-2 flex-shrink-0">
                <path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0zm-3.97-3.03a.75.75 0 0 0-1.08.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-.01-1.05z" />
            </svg>
            <span>@TempData["SuccessMessage"]</span>
        </div>
    }
    @if (TempData["ErrorMessage"] is not null)
    {
        <div class="alert alert-danger d-flex align-items-center mb-4" role="alert">
            <svg width="18" height="18" fill="currentColor" viewBox="0 0 16 16" class="me-2 flex-shrink-0">
                <path d="M8.982 1.566a1.13 1.13 0 0 0-1.96 0L.165 13.233c-.457.778.091 1.767.98 1.767h13.713c.889 0 1.438-.99.98-1.767L8.982 1.566zM8 5c.535 0 .954.462.9.995l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 5.995A.905.905 0 0 1 8 5zm.002 6a1 1 0 1 1 0 2 1 1 0 0 1 0-2z" />
            </svg>
            <span>@TempData["ErrorMessage"]</span>
        </div>
    }

    <div class="row g-4">
        <!-- Wallets List -->
        <div class="col-lg-7">
            <div class="card h-100">
                <div class="card-header bg-transparent border-bottom d-flex justify-content-between align-items-center py-3">
                    <h5 class="mb-0">
                        <svg width="18" height="18" fill="currentColor" viewBox="0 0 16 16" class="me-2">
                            <path d="M0 4a1 1 0 0 1 1-1h14a1 1 0 0 1 1 1v8a1 1 0 0 1-1 1H1a1 1 0 0 1-1-1V4Zm1 0v1h14V4H1Zm14 2H1v5h14V6ZM2 9.5a.5.5 0 0 1 .5-.5h2a.5.5 0 0 1 0 1h-2a.5.5 0 0 1-.5-.5Zm0 2a.5.5 0 0 1 .5-.5h2a.5.5 0 0 1 0 1h-2a.5.5 0 0 1-.5-.5Z" />
                        </svg>
                        Your Wallets
                    </h5>
                    <span class="badge bg-primary">@Model.Wallets.Count() Total</span>
                </div>
                <div class="card-body p-0">
                    @if (Model.Wallets.Any())
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var wallet in Model.Wallets)
                            {
                                <div class="list-group-item py-3 px-4">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <div class="d-flex align-items-center gap-3">
                                            <div class="qp-wallet-icon">
                                                <svg width="20" height="20" fill="currentColor" viewBox="0 0 16 16">
                                                    <path d="M0 4a1 1 0 0 1 1-1h14a1 1 0 0 1 1 1v8a1 1 0 0 1-1 1H1a1 1 0 0 1-1-1V4Zm1 0v1h14V4H1Zm14 2H1v5h14V6ZM2 9.5a.5.5 0 0 1 .5-.5h2a.5.5 0 0 1 0 1h-2a.5.5 0 0 1-.5-.5Zm0 2a.5.5 0 0 1 .5-.5h2a.5.5 0 0 1 0 1h-2a.5.5 0 0 1-.5-.5Z" />
                                                </svg>
                                            </div>
                                            <div>
                                                <div class="fw-semibold fs-5">@wallet.Name</div>
                                                <small class="text-muted">@wallet.Currency</small>
                                            </div>
                                        </div>
                                        <div class="qp-wallet-balance">
                                            <span class="amount fs-5">@wallet.Balance.ToString("N2")</span>
                                            <small class="text-muted ms-1">@wallet.Currency</small>
                                        </div>
                                    </div>

                                    <div class="d-flex gap-2 mt-3">
                                        <form asp-action="Rename" method="post" class="flex-grow-1 d-flex gap-2">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="walletId" value="@wallet.Id" />
                                            <input type="text" name="newName" value="@wallet.Name" class="form-control form-control-sm" />
                                            <button type="submit" class="btn btn-secondary btn-sm">
                                                <svg width="14" height="14" fill="currentColor" viewBox="0 0 16 16" class="me-1">
                                                    <path d="M12.854.146a.5.5 0 0 0-.707 0L10.5 1.793 14.207 5.5l1.647-1.646a.5.5 0 0 0 0-.708l-3-3zm.646 6.061L9.793 2.5 3.293 9H3.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.207l6.5-6.5zm-7.468 7.468A.5.5 0 0 1 6 13.5V13h-.5a.5.5 0 0 1-.5-.5V12h-.5a.5.5 0 0 1-.5-.5V11h-.5a.5.5 0 0 1-.5-.5V10h-.5a.499.499 0 0 1-.175-.032l-.179.178a.5.5 0 0 0-.11.168l-2 5a.5.5 0 0 0 .65.65l5-2a.5.5 0 0 0 .168-.11l.178-.178z" />
                                                </svg>
                                                Rename
                                            </button>
                                        </form>

                                        <form asp-action="Delete" method="post" onsubmit="return confirm('Are you sure you want to delete this wallet?');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="walletId" value="@wallet.Id" />
                                            <button type="submit" class="btn btn-outline-danger btn-sm">
                                                <svg width="14" height="14" fill="currentColor" viewBox="0 0 16 16" class="me-1">
                                                    <path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5zm2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5zm3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0V6z" />
                                                    <path fill-rule="evenodd" d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1v1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4H4.118zM2.5 3V2h11v1h-11z" />
                                                </svg>
                                                Delete
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <div class="qp-empty-icon mb-3">
                                <svg width="48" height="48" fill="currentColor" viewBox="0 0 16 16">
                                    <path d="M0 4a1 1 0 0 1 1-1h14a1 1 0 0 1 1 1v8a1 1 0 0 1-1 1H1a1 1 0 0 1-1-1V4Zm1 0v1h14V4H1Zm14 2H1v5h14V6ZM2 9.5a.5.5 0 0 1 .5-.5h2a.5.5 0 0 1 0 1h-2a.5.5 0 0 1-.5-.5Zm0 2a.5.5 0 0 1 .5-.5h2a.5.5 0 0 1 0 1h-2a.5.5 0 0 1-.5-.5Z" />
                                </svg>
                            </div>
                            <h6 class="fw-semibold mb-2">No Wallets Yet</h6>
                            <p class="text-muted mb-3">Create your first wallet to start managing your money.</p>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Create Wallet -->
        <div class="col-lg-5">
            <div class="card qp-create-wallet-card h-100">
                <div class="card-header bg-transparent border-bottom py-3">
                    <h5 class="mb-0">
                        <svg width="18" height="18" fill="currentColor" viewBox="0 0 16 16" class="me-2">
                            <path d="M8 4a.5.5 0 0 1 .5.5v3h3a.5.5 0 0 1 0 1h-3v3a.5.5 0 0 1-1 0v-3h-3a.5.5 0 0 1 0-1h3v-3A.5.5 0 0 1 8 4z" />
                        </svg>
                        Create New Wallet
                    </h5>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Create" method="post">
                        @Html.AntiForgeryToken()
                        <div class="mb-3">
                            <label for="newWalletName" class="form-label">Wallet Name</label>
                            <div class="input-group">
                                <span class="input-group-text">
                                    <svg width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                                        <path d="M0 4a1 1 0 0 1 1-1h14a1 1 0 0 1 1 1v8a1 1 0 0 1-1 1H1a1 1 0 0 1-1-1V4Zm1 0v1h14V4H1Zm14 2H1v5h14V6ZM2 9.5a.5.5 0 0 1 .5-.5h2a.5.5 0 0 1 0 1h-2a.5.5 0 0 1-.5-.5Zm0 2a.5.5 0 0 1 .5-.5h2a.5.5 0 0 1 0 1h-2a.5.5 0 0 1-.5-.5Z" />
                                    </svg>
                                </span>
                                <input type="text" id="newWalletName" name="newWalletName" class="form-control" placeholder="e.g., Savings, Travel, Bills" />
                            </div>
                        </div>

                        <div class="qp-info-box mb-3">
                            <svg width="16" height="16" fill="currentColor" viewBox="0 0 16 16" class="me-2 flex-shrink-0">
                                <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14zm0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16z" />
                                <path d="m8.93 6.588-2.29.287-.082.38.45.083c.294.07.352.176.288.469l-.738 3.468c-.194.897.105 1.319.808 1.319.545 0 1.178-.252 1.465-.598l.088-.416c-.2.176-.492.246-.686.246-.275 0-.375-.193-.304-.533L8.93 6.588zM9 4.5a1 1 0 1 1-2 0 1 1 0 0 1 2 0z" />
                            </svg>
                            <span>Create multiple wallets for different purposes.</span>
                        </div>

                        <button type="submit" class="btn btn-primary w-100">
                            <svg width="16" height="16" fill="currentColor" viewBox="0 0 16 16" class="me-2">
                                <path d="M8 4a.5.5 0 0 1 .5.5v3h3a.5.5 0 0 1 0 1h-3v3a.5.5 0 0 1-1 0v-3h-3a.5.5 0 0 1 0-1h3v-3A.5.5 0 0 1 8 4z" />
                            </svg>
                            Create Wallet
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>