@using QuickPay.BLL.DTOs
@model IEnumerable<TransactionHistoryDto>

@{
    ViewData["Title"] = "Transaction History";
    var pageNumber = (int)(ViewBag.PageNumber ?? 1);
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8">

            <h2 class="mb-4">Transaction History</h2>

            @if (!Model.Any())
            {
                <p class="text-muted">No transactions yet.</p>
            }
            else
            {
                <table class="table">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Type</th>
                            <th>Direction</th>
                            <th>Amount</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var tx in Model)
                        {
                            <tr>
                                <td>@tx.CreatedAt.ToString("g")</td>
                                <td>@tx.Type</td>
                                <td>
                                    <span class="badge @(tx.Direction == "Outgoing" ? "bg-danger" : "bg-success")">
                                        @tx.Direction
                                    </span>
                                </td>
                                <td>@tx.Amount.ToString("N2")</td>
                                <td>@tx.Status</td>
                            </tr>
                        }
                    </tbody>
                </table>

                <div class="d-flex justify-content-between">
                    @if (pageNumber > 1)
                    {
                        <a asp-action="Index" asp-route-pageNumber="@(pageNumber - 1)" class="btn btn-outline-secondary">
                            Previous
                        </a>
                    }
                    else
                    {
                        <span></span>
                    }

                    <a asp-action="Index" asp-route-pageNumber="@(pageNumber + 1)" class="btn btn-outline-secondary">
                        Next
                    </a>
                </div>
            }

        </div>
    </div>
</div>
