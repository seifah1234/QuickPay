@using QuickPay.BLL.DTOs
@using QuickPay.BLL.DTOs.SmartSplit
@model SplitGroupDto

@{
    ViewData["Title"] = "Split Details";
    var currentUserId = (int)ViewBag.CurrentUserId;
    var myWallets = (IEnumerable<WalletDto>)ViewBag.MyWallets;
    var isInitiator = Model.InitiatorUserId == currentUserId;
    var myShare = Model.Participants.FirstOrDefault(p => p.UserId == currentUserId);
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-7">

            @if (TempData["SuccessMessage"] is not null)
            {
                <div class="alert alert-success">@TempData["SuccessMessage"]</div>
            }
            @if (TempData["ErrorMessage"] is not null)
            {
                <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
            }

            <div class="card shadow-sm mb-4">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <h2 class="mb-1">@Model.TotalAmount.ToString("N2") @Model.Currency</h2>
                            <span class="text-muted">by @Model.InitiatorUserName &middot; @Model.SplitType split</span>
                        </div>
                        <span class="badge @(Model.Status switch {
                            "Completed" => "bg-success",
                            "Cancelled" => "bg-secondary",
                            "PartiallyPaid" => "bg-warning text-dark",
                            _ => "bg-light text-dark"
                        }) fs-6">@Model.Status</span>
                    </div>

                    @if (Model.DueDate is not null)
                    {
                        <p class="text-muted small mt-2 mb-0">Due @Model.DueDate.Value.ToString("MMM d, yyyy")</p>
                    }

                    @if (isInitiator && Model.Status == "Pending")
                    {
                        <form asp-action="Cancel" method="post" class="mt-3"
                              onsubmit="return confirm('Cancel this split? Nobody has paid yet.');">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@Model.Id" />
                            <button type="submit" class="btn btn-outline-danger btn-sm">Cancel Split</button>
                        </form>
                    }
                </div>
            </div>

            @if (myShare is not null && myShare.Status == "Pending" && Model.Status != "Cancelled")
            {
                <div class="card shadow-sm mb-4 border-primary">
                    <div class="card-body p-4">
                        <h5 class="mb-3">Your share: @myShare.Amount.ToString("N2") @Model.Currency</h5>
                        <form asp-action="Pay" method="post" class="d-flex gap-2">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@Model.Id" />
                            <select name="fromWalletId" class="form-select">
                                @foreach (var wallet in myWallets)
                                {
                                    <option value="@wallet.Id">@wallet.Name (@wallet.Balance.ToString("N2") @wallet.Currency)</option>
                                }
                            </select>
                            <button type="submit" class="btn btn-primary text-nowrap">Pay My Share</button>
                        </form>
                    </div>
                </div>
            }

            <div class="card shadow-sm">
                <div class="card-body p-4">
                    <h5 class="mb-3">Participants</h5>

                    <table class="table table-sm align-middle">
                        <tbody>
                            @foreach (var participant in Model.Participants)
                            {
                                <tr>
                                    <td>@participant.UserName</td>
                                    <td>@participant.Amount.ToString("N2") @Model.Currency</td>
                                    <td>
                                        <span class="badge @(participant.Status == "Paid" ? "bg-success" : "bg-light text-dark")">
                                            @participant.Status
                                        </span>
                                    </td>
                                    <td class="text-end">
                                        @if (isInitiator && participant.Status == "Pending")
                                        {
                                            <form asp-action="Remind" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@Model.Id" />
                                                <input type="hidden" name="participantUserId" value="@participant.UserId" />
                                                <button type="submit" class="btn btn-sm btn-outline-secondary">Remind</button>
                                            </form>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>

                    @if (isInitiator && Model.Participants.Any(p => p.Status == "Pending"))
                    {
                        <form asp-action="Remind" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@Model.Id" />
                            <button type="submit" class="btn btn-outline-secondary btn-sm">Remind Everyone Pending</button>
                        </form>
                    }
                </div>
            </div>

        </div>
    </div>
</div>
