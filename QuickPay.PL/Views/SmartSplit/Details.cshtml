@using QuickPay.BLL.DTOs
@using QuickPay.BLL.DTOs.SmartSplit
@model SplitGroupDto

@{
    ViewData["Title"] = "Split Details";
    var currentUserId = (int)ViewBag.CurrentUserId;
    var myWallets = (IEnumerable<WalletDto>)ViewBag.MyWallets;
    var isInitiator = Model.InitiatorUserId == currentUserId;
    var myShare = Model.Participants.FirstOrDefault(p => p.UserId == currentUserId);
}

<div class="container py-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <div>
            <h1 class="qp-dashboard-title mb-1">Split Details</h1>
            <p class="text-muted mb-0">View and manage your split details.</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <svg width="16" height="16" fill="currentColor" viewBox="0 0 16 16" class="me-2">
                <path fill-rule="evenodd" d="M15 8a.5.5 0 0 0-.5-.5H2.707l3.147-3.146a.5.5 0 1 0-.708-.708l-4 4a.5.5 0 0 0 0 .708l4 4a.5.5 0 0 0 .708-.708L2.707 8.5H14.5A.5.5 0 0 0 15 8z" />
            </svg>
            Back to Splits
        </a>
    </div>

    <!-- Alerts -->
    @if (TempData["SuccessMessage"] is not null)
    {
        <div class="alert alert-success d-flex align-items-center mb-4" role="alert">
            <svg width="18" height="18" fill="currentColor" viewBox="0 0 16 16" class="me-2 flex-shrink-0">
                <path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0zm-3.97-3.03a.75.75 0 0 0-1.08.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-.01-1.05z" />
            </svg>
            <span>@TempData["SuccessMessage"]</span>
        </div>
    }
    @if (TempData["ErrorMessage"] is not null)
    {
        <div class="alert alert-danger d-flex align-items-center mb-4" role="alert">
            <svg width="18" height="18" fill="currentColor" viewBox="0 0 16 16" class="me-2 flex-shrink-0">
                <path d="M8.982 1.566a1.13 1.13 0 0 0-1.96 0L.165 13.233c-.457.778.091 1.767.98 1.767h13.713c.889 0 1.438-.99.98-1.767L8.982 1.566zM8 5c.535 0 .954.462.9.995l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 5.995A.905.905 0 0 1 8 5zm.002 6a1 1 0 1 1 0 2 1 1 0 0 1 0-2z" />
            </svg>
            <span>@TempData["ErrorMessage"]</span>
        </div>
    }

    <!-- Split Summary -->
    <div class="card qp-split-summary mb-4">
        <div class="card-body p-4">
            <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
                <div>
                    <h2 class="mb-1">
                        <span class="amount">@Model.TotalAmount.ToString("N2")</span>
                        <span class="text-muted fs-5">@Model.Currency</span>
                    </h2>
                    <span class="text-muted">by @Model.InitiatorUserName &middot; @Model.SplitType split</span>

                    @if (Model.DueDate is not null)
                    {
                        <div class="mt-2">
                            <span class="badge bg-light text-dark">
                                <svg width="12" height="12" fill="currentColor" viewBox="0 0 16 16" class="me-1">
                                    <path d="M3.5 0a.5.5 0 0 1 .5.5V1h8V.5a.5.5 0 0 1 1 0V1h1a2 2 0 0 1 2 2v11a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V3a2 2 0 0 1 2-2h1V.5a.5.5 0 0 1 .5-.5zM1 4v10a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V4H1z" />
                                </svg>
                                Due @Model.DueDate.Value.ToString("MMM d, yyyy")
                            </span>
                        </div>
                    }
                </div>
                <span class="badge @(Model.Status switch
                      {
                          "Completed" => "bg-success",
                          "Cancelled" => "bg-secondary",
                          "PartiallyPaid" => "bg-warning text-dark",
                          _ => "bg-light text-dark"
                      }) fs-6">
                    @Model.Status
                </span>
            </div>

            @if (isInitiator && Model.Status == "Pending")
            {
                <form asp-action="Cancel" method="post" class="mt-3"
                      onsubmit="return confirm('Cancel this split? Nobody has paid yet.');">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />
                    <button type="submit" class="btn btn-outline-danger btn-sm">
                        <svg width="14" height="14" fill="currentColor" viewBox="0 0 16 16" class="me-1">
                            <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14zm0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16z" />
                            <path d="M4.646 4.646a.5.5 0 0 1 .708 0L8 7.293l2.646-2.647a.5.5 0 0 1 .708.708L8.707 8l2.647 2.646a.5.5 0 0 1-.708.708L8 8.707l-2.646 2.647a.5.5 0 0 1-.708-.708L7.293 8 4.646 5.354a.5.5 0 0 1 0-.708z" />
                        </svg>
                        Cancel Split
                    </button>
                </form>
            }
        </div>
    </div>

    <!-- My Share -->
    @if (myShare is not null && myShare.Status == "Pending" && Model.Status != "Cancelled")
    {
        <div class="card qp-my-share mb-4">
            <div class="card-body p-4">
                <h5 class="mb-3">
                    Your Share:
                    <span class="amount">@myShare.Amount.ToString("N2") @Model.Currency</span>
                </h5>
                <form asp-action="Pay" method="post" class="d-flex gap-2 flex-wrap">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />
                    <select name="fromWalletId" class="form-select flex-grow-1">
                        @foreach (var wallet in myWallets)
                        {
                            <option value="@wallet.Id">
                                @wallet.Name (@wallet.Balance.ToString("N2") @wallet.Currency)
                            </option>
                        }
                    </select>
                    <button type="submit" class="btn btn-primary text-nowrap">
                        <svg width="16" height="16" fill="currentColor" viewBox="0 0 16 16" class="me-2">
                            <path d="M8 1a2 2 0 0 1 2 2v4H6V3a2 2 0 0 1 2-2zm3 6V3a3 3 0 0 0-6 0v4a2 2 0 0 0-2 2v5a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2z" />
                        </svg>
                        Pay My Share
                    </button>
                </form>
            </div>
        </div>
    }

    <!-- Participants -->
    <div class="card">
        <div class="card-header bg-transparent border-bottom py-3">
            <h5 class="mb-0">
                <svg width="18" height="18" fill="currentColor" viewBox="0 0 16 16" class="me-2">
                    <path d="M15 14s1 0 1-1-1-4-5-4-5 3-5 4 1 1 1 1h8Zm-7.978-1A.261.261 0 0 1 7 12.996c.001-.264.167-1.03.76-1.72C8.312 10.629 9.282 10 11 10c1.717 0 2.687.63 3.24 1.276.593.69.758 1.457.76 1.72l-.008.002a.274.274 0 0 1-.014.002H7.022ZM11 7a2 2 0 1 0 0-4 2 2 0 0 0 0 4Zm3-2a3 3 0 1 1-6 0 3 3 0 0 1 6 0ZM6.936 9.28a5.88 5.88 0 0 0-1.23-.247A7.35 7.35 0 0 0 5 9c-4 0-5 3-5 4 0 .667.333 1 1 1h4.216A2.238 2.238 0 0 1 5 13c0-1.01.377-2.042 1.09-2.904.243-.294.526-.569.846-.816ZM4.92 10A5.493 5.493 0 0 0 4 13H1c0-.26.164-1.03.76-1.724.545-.636 1.492-1.256 3.16-1.275ZM1.5 5.5a3 3 0 1 1 6 0 3 3 0 0 1-6 0Zm3-2a2 2 0 1 0 0 4 2 2 0 0 0 0-4Z" />
                </svg>
                Participants
            </h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table mb-0">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Amount</th>
                            <th>Status</th>
                            @if (isInitiator)
                            {
                                <th class="text-end">Actions</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var participant in Model.Participants)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="qp-participant-avatar">
                                            @participant.UserName.Substring(0, 1).ToUpper()
                                        </div>
                                        <span>@participant.UserName</span>
                                    </div>
                                </td>
                                <td>
                                    <span class="amount">@participant.Amount.ToString("N2") @Model.Currency</span>
                                </td>
                                <td>
                                    <span class="badge @(participant.Status == "Paid" ? "bg-success" : "bg-light text-dark")">
                                        @participant.Status
                                    </span>
                                </td>
                                @if (isInitiator)
                                {
                                    <td class="text-end">
                                        @if (participant.Status == "Pending")
                                        {
                                            <form asp-action="Remind" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@Model.Id" />
                                                <input type="hidden" name="participantUserId" value="@participant.UserId" />
                                                <button type="submit" class="btn btn-sm btn-outline-secondary">
                                                    <svg width="14" height="14" fill="currentColor" viewBox="0 0 16 16" class="me-1">
                                                        <path d="M8 16a2 2 0 0 0 2-2H6a2 2 0 0 0 2 2zM8 1.918l-.797.161A4.002 4.002 0 0 0 4 6c0 .628-.134 2.197-.459 3.742-.16.767-.376 1.566-.663 2.258h10.244c-.287-.692-.502-1.49-.663-2.258C12.134 8.197 12 6.628 12 6a4.002 4.002 0 0 0-3.203-3.92L8 1.917zM14.22 12c.223.447.481.801.78 1H1c.299-.199.557-.553.78-1C2.68 10.2 3 9.073 3 8c0-2.754 1.781-5.05 4.258-5.74A2 2 0 1 1 9.742 2.26C12.219 2.95 14 5.246 14 8c0 1.073.32 2.2 1.22 4z" />
                                                    </svg>
                                                    Remind
                                                </button>
                                            </form>
                                        }
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        @if (isInitiator && Model.Participants.Any(p => p.Status == "Pending"))
        {
            <div class="card-footer bg-transparent border-top py-3">
                <form asp-action="Remind" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />
                    <button type="submit" class="btn btn-outline-secondary btn-sm">
                        <svg width="14" height="14" fill="currentColor" viewBox="0 0 16 16" class="me-1">
                            <path d="M8 16a2 2 0 0 0 2-2H6a2 2 0 0 0 2 2zM8 1.918l-.797.161A4.002 4.002 0 0 0 4 6c0 .628-.134 2.197-.459 3.742-.16.767-.376 1.566-.663 2.258h10.244c-.287-.692-.502-1.49-.663-2.258C12.134 8.197 12 6.628 12 6a4.002 4.002 0 0 0-3.203-3.92L8 1.917zM14.22 12c.223.447.481.801.78 1H1c.299-.199.557-.553.78-1C2.68 10.2 3 9.073 3 8c0-2.754 1.781-5.05 4.258-5.74A2 2 0 1 1 9.742 2.26C12.219 2.95 14 5.246 14 8c0 1.073.32 2.2 1.22 4z" />
                        </svg>
                        Remind Everyone Pending
                    </button>
                </form>
            </div>
        }
    </div>
</div>