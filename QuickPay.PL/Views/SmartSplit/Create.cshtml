@using QuickPay.BLL.DTOs
@{
    ViewData["Title"] = "New Split";
    var myWallets = (IEnumerable<WalletDto>)ViewBag.MyWallets;
}

<div class="container py-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <div>
            <h1 class="qp-dashboard-title mb-1">New Split</h1>
            <p class="text-muted mb-0">Create a new expense split with friends.</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <svg width="16" height="16" fill="currentColor" viewBox="0 0 16 16" class="me-2">
                <path fill-rule="evenodd" d="M15 8a.5.5 0 0 0-.5-.5H2.707l3.147-3.146a.5.5 0 1 0-.708-.708l-4 4a.5.5 0 0 0 0 .708l4 4a.5.5 0 0 0 .708-.708L2.707 8.5H14.5A.5.5 0 0 0 15 8z" />
            </svg>
            Back
        </a>
    </div>

    <div class="card">
        <div class="card-header bg-transparent border-bottom py-3">
            <h5 class="mb-0">
                <svg width="18" height="18" fill="currentColor" viewBox="0 0 16 16" class="me-2">
                    <path d="M8 4a.5.5 0 0 1 .5.5v3h3a.5.5 0 0 1 0 1h-3v3a.5.5 0 0 1-1 0v-3h-3a.5.5 0 0 1 0-1h3v-3A.5.5 0 0 1 8 4z" />
                </svg>
                Split Details
            </h5>
        </div>
        <div class="card-body p-4">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()

                <div class="mb-4">
                    <label class="form-label">Settle into wallet</label>
                    <div class="input-group">
                        <span class="input-group-text">
                            <svg width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                                <path d="M0 4a1 1 0 0 1 1-1h14a1 1 0 0 1 1 1v8a1 1 0 0 1-1 1H1a1 1 0 0 1-1-1V4Zm1 0v1h14V4H1Zm14 2H1v5h14V6ZM2 9.5a.5.5 0 0 1 .5-.5h2a.5.5 0 0 1 0 1h-2a.5.5 0 0 1-.5-.5Zm0 2a.5.5 0 0 1 .5-.5h2a.5.5 0 0 1 0 1h-2a.5.5 0 0 1-.5-.5Z" />
                            </svg>
                        </span>
                        <select name="settlementWalletId" class="form-select" required>
                            @foreach (var wallet in myWallets)
                            {
                                <option value="@wallet.Id">@wallet.Name (@wallet.Balance.ToString("N2") @wallet.Currency)</option>
                            }
                        </select>
                    </div>
                    <div class="form-text">Participants' payments land here.</div>
                </div>

                <div class="mb-4">
                    <label class="form-label">Total Amount (EGP)</label>
                    <div class="input-group">
                        <span class="input-group-text">
                            <svg width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                                <path d="M8 1a2 2 0 0 1 2 2v4H6V3a2 2 0 0 1 2-2zm3 6V3a3 3 0 0 0-6 0v4a2 2 0 0 0-2 2v5a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2z" />
                            </svg>
                        </span>
                        <input type="number" step="0.01" min="0.01" name="totalAmount" class="form-control" required />
                        <span class="input-group-text">EGP</span>
                    </div>
                </div>

                <div class="mb-4">
                    <label class="form-label">Split Type</label>
                    <div class="input-group">
                        <span class="input-group-text">
                            <svg width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                                <path d="M7 1.5a.5.5 0 0 1 .5.5v1.04a4 4 0 0 1 3 3.92h1.04a.5.5 0 0 1 0 1H10.5a4 4 0 0 1-3 3.92v1.04a.5.5 0 0 1-1 0v-1.04a4 4 0 0 1-3-3.92H2.5a.5.5 0 0 1 0-1h1.04a4 4 0 0 1 3-3.92V2a.5.5 0 0 1 .5-.5Zm0 2.06A3 3 0 0 0 4.06 6.5h5.88A3 3 0 0 0 7 3.56Zm0 8.88a3 3 0 0 0 2.94-2.44H4.06A3 3 0 0 0 7 12.44Z" />
                            </svg>
                        </span>
                        <select name="splitType" id="splitType" class="form-select" onchange="updateHint()">
                            <option value="Equal">Equal - split evenly</option>
                            <option value="CustomAmount">Custom Amount - you set each person's amount</option>
                            <option value="Percentage">Percentage - you set each person's %</option>
                        </select>
                    </div>
                </div>

                <div class="mb-4">
                    <label class="form-label">Participants (one per line)</label>
                    <textarea name="participantLines" class="form-control" rows="5"
                              placeholder="username, phone, or email"></textarea>
                    <div id="participantHint" class="form-text">
                        Equal split: just one identifier per line, e.g. <code>sara_2001</code>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-4">
                        <label class="form-label">Due Date (optional)</label>
                        <input type="date" name="dueDate" class="form-control" />
                    </div>
                    <div class="col-md-6 mb-4">
                        <label class="form-label">Note (optional)</label>
                        <input type="text" name="description" class="form-control" placeholder="e.g. Dinner at Zooba" />
                    </div>
                </div>

                <button type="submit" class="btn btn-primary w-100 btn-lg">
                    <svg width="18" height="18" fill="currentColor" viewBox="0 0 16 16" class="me-2">
                        <path d="M8 4a.5.5 0 0 1 .5.5v3h3a.5.5 0 0 1 0 1h-3v3a.5.5 0 0 1-1 0v-3h-3a.5.5 0 0 1 0-1h3v-3A.5.5 0 0 1 8 4z" />
                    </svg>
                    Create Split
                </button>
            </form>
        </div>
    </div>
</div>

<script>
    function updateHint() {
        var type = document.getElementById('splitType').value;
        var hint = document.getElementById('participantHint');
        if (type === 'CustomAmount') {
            hint.innerHTML = 'One per line as <code>identifier, amount</code>, e.g. <code>sara_2001, 50.00</code>. Amounts must add up to the total.';
        } else if (type === 'Percentage') {
            hint.innerHTML = 'One per line as <code>identifier, percentage</code>, e.g. <code>sara_2001, 25</code>. Percentages must add up to 100.';
        } else {
            hint.innerHTML = 'Equal split: just one identifier per line, e.g. <code>sara_2001</code>';
        }
    }
</script>