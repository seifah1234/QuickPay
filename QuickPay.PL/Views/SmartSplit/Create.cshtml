@using QuickPay.BLL.DTOs
@{
    ViewData["Title"] = "New Split";
    var myWallets = (IEnumerable<WalletDto>)ViewBag.MyWallets;
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-7">

            <h2 class="mb-4">New Split</h2>

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label class="form-label">Settle into wallet</label>
                    <select name="settlementWalletId" class="form-select" required>
                        @foreach (var wallet in myWallets)
                        {
                            <option value="@wallet.Id">@wallet.Name (@wallet.Balance.ToString("N2") @wallet.Currency)</option>
                        }
                    </select>
                    <div class="form-text">Participants' payments land here.</div>
                </div>

                <div class="mb-3">
                    <label class="form-label">Total Amount (EGP)</label>
                    <input type="number" step="0.01" min="0.01" name="totalAmount" class="form-control" required />
                </div>

                <div class="mb-3">
                    <label class="form-label">Split Type</label>
                    <select name="splitType" id="splitType" class="form-select" onchange="updateHint()">
                        <option value="Equal">Equal - split evenly</option>
                        <option value="CustomAmount">Custom Amount - you set each person's amount</option>
                        <option value="Percentage">Percentage - you set each person's %</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label">Participants (one per line)</label>
                    <textarea name="participantLines" class="form-control" rows="5"
                              placeholder="username, phone, or email"></textarea>
                    <div id="participantHint" class="form-text">
                        Equal split: just one identifier per line, e.g. <code>sara_2001</code>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label">Due Date (optional)</label>
                    <input type="date" name="dueDate" class="form-control" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Note (optional)</label>
                    <input type="text" name="description" class="form-control" placeholder="e.g. Dinner at Zooba" />
                </div>

                <button type="submit" class="btn btn-primary w-100">Create Split</button>
            </form>

        </div>
    </div>
</div>

<script>
    function updateHint() {
        var type = document.getElementById('splitType').value;
        var hint = document.getElementById('participantHint');
        if (type === 'CustomAmount') {
            hint.innerHTML = 'One per line as <code>identifier, amount</code>, e.g. <code>sara_2001, 50.00</code>. Amounts must add up to the total.';
        } else if (type === 'Percentage') {
            hint.innerHTML = 'One per line as <code>identifier, percentage</code>, e.g. <code>sara_2001, 25</code>. Percentages must add up to 100.';
        } else {
            hint.innerHTML = 'Equal split: just one identifier per line, e.g. <code>sara_2001</code>';
        }
    }
</script>
