@using QuickPay.BLL.DTOs.SmartSplit
@model IEnumerable<SplitGroupDto>

@{
    ViewData["Title"] = "Smart Split";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8">

            @if (TempData["SuccessMessage"] is not null)
            {
                <div class="alert alert-success">@TempData["SuccessMessage"]</div>
            }
            @if (TempData["ErrorMessage"] is not null)
            {
                <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
            }

            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2 class="mb-0">Smart Split</h2>
                <a asp-action="Create" class="btn btn-primary">+ New Split</a>
            </div>

            @if (!Model.Any())
            {
                <p class="text-muted">No splits yet.</p>
            }

            @foreach (var split in Model)
            {
                var paidCount = split.Participants.Count(p => p.Status == "Paid");
                var totalCount = split.Participants.Count();

                <a asp-action="Details" asp-route-id="@split.Id" class="text-decoration-none text-body">
                    <div class="card shadow-sm mb-3">
                        <div class="card-body p-4 d-flex justify-content-between align-items-center">
                            <div>
                                <h5 class="mb-1">@split.TotalAmount.ToString("N2") @split.Currency</h5>
                                <span class="text-muted small">
                                    by @split.InitiatorUserName &middot; @split.SplitType split &middot; @paidCount/@totalCount paid
                                </span>
                            </div>
                            <span class="badge @(split.Status switch {
                                "Completed" => "bg-success",
                                "Cancelled" => "bg-secondary",
                                "PartiallyPaid" => "bg-warning text-dark",
                                _ => "bg-light text-dark"
                            })">@split.Status</span>
                        </div>
                    </div>
                </a>
            }

        </div>
    </div>
</div>
