@using QuickPay.BLL.DTOs.SmartSplit
@model IEnumerable<SplitGroupDto>

@{
    ViewData["Title"] = "Smart Split";
}

<div class="container py-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <div>
            <h1 class="qp-dashboard-title mb-1">Smart Split</h1>
            <p class="text-muted mb-0">Split bills and expenses with friends easily.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">
                <svg width="16" height="16" fill="currentColor" viewBox="0 0 16 16" class="me-2">
                    <path fill-rule="evenodd" d="M15 8a.5.5 0 0 0-.5-.5H2.707l3.147-3.146a.5.5 0 1 0-.708-.708l-4 4a.5.5 0 0 0 0 .708l4 4a.5.5 0 0 0 .708-.708L2.707 8.5H14.5A.5.5 0 0 0 15 8z" />
                </svg>
                Back
            </a>
            <a asp-action="Create" class="btn btn-primary">
                <svg width="16" height="16" fill="currentColor" viewBox="0 0 16 16" class="me-2">
                    <path d="M8 4a.5.5 0 0 1 .5.5v3h3a.5.5 0 0 1 0 1h-3v3a.5.5 0 0 1-1 0v-3h-3a.5.5 0 0 1 0-1h3v-3A.5.5 0 0 1 8 4z" />
                </svg>
                New Split
            </a>
        </div>
    </div>

    <!-- Alerts -->
    @if (TempData["SuccessMessage"] is not null)
    {
        <div class="alert alert-success d-flex align-items-center mb-4" role="alert">
            <svg width="18" height="18" fill="currentColor" viewBox="0 0 16 16" class="me-2 flex-shrink-0">
                <path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0zm-3.97-3.03a.75.75 0 0 0-1.08.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-.01-1.05z" />
            </svg>
            <span>@TempData["SuccessMessage"]</span>
        </div>
    }
    @if (TempData["ErrorMessage"] is not null)
    {
        <div class="alert alert-danger d-flex align-items-center mb-4" role="alert">
            <svg width="18" height="18" fill="currentColor" viewBox="0 0 16 16" class="me-2 flex-shrink-0">
                <path d="M8.982 1.566a1.13 1.13 0 0 0-1.96 0L.165 13.233c-.457.778.091 1.767.98 1.767h13.713c.889 0 1.438-.99.98-1.767L8.982 1.566zM8 5c.535 0 .954.462.9.995l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 5.995A.905.905 0 0 1 8 5zm.002 6a1 1 0 1 1 0 2 1 1 0 0 1 0-2z" />
            </svg>
            <span>@TempData["ErrorMessage"]</span>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="card">
            <div class="card-body text-center py-5">
                <div class="qp-empty-icon mb-3">
                    <svg width="48" height="48" fill="currentColor" viewBox="0 0 16 16">
                        <path d="M7 1.5a.5.5 0 0 1 .5.5v1.04a4 4 0 0 1 3 3.92h1.04a.5.5 0 0 1 0 1H10.5a4 4 0 0 1-3 3.92v1.04a.5.5 0 0 1-1 0v-1.04a4 4 0 0 1-3-3.92H2.5a.5.5 0 0 1 0-1h1.04a4 4 0 0 1 3-3.92V2a.5.5 0 0 1 .5-.5Zm0 2.06A3 3 0 0 0 4.06 6.5h5.88A3 3 0 0 0 7 3.56Zm0 8.88a3 3 0 0 0 2.94-2.44H4.06A3 3 0 0 0 7 12.44Z" />
                    </svg>
                </div>
                <h6 class="fw-semibold mb-2">No Splits Yet</h6>
                <p class="text-muted mb-3">Create your first split to share expenses with friends.</p>
                <a asp-action="Create" class="btn btn-primary btn-sm">Create New Split</a>
            </div>
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var split in Model)
            {
                var paidCount = split.Participants.Count(p => p.Status == "Paid");
                var totalCount = split.Participants.Count();

                <div class="col-md-6">
                    <a asp-action="Details" asp-route-id="@split.Id" class="text-decoration-none">
                        <div class="card qp-split-card h-100">
                            <div class="card-body p-4">
                                <div class="d-flex justify-content-between align-items-start mb-3">
                                    <div>
                                        <h5 class="mb-1">
                                            <span class="amount">@split.TotalAmount.ToString("N2")</span>
                                            <span class="text-muted fs-6">@split.Currency</span>
                                        </h5>
                                        <span class="text-muted small">
                                            by @split.InitiatorUserName &middot; @split.SplitType split
                                        </span>
                                    </div>
                                    <span class="badge @(split.Status switch
                                          {
                                              "Completed" => "bg-success",
                                              "Cancelled" => "bg-secondary",
                                              "PartiallyPaid" => "bg-warning text-dark",
                                              _ => "bg-light text-dark"
                                          })">
                                        @split.Status
                                    </span>
                                </div>

                                <div class="qp-progress mb-2">
                                    <div class="qp-progress-bar" style="width: @(totalCount > 0 ? (paidCount * 100 / totalCount) : 0)%"></div>
                                </div>
                                <div class="d-flex justify-content-between">
                                    <small class="text-muted">@paidCount of @totalCount paid</small>
                                    <small class="text-muted">@(totalCount > 0 ? (paidCount * 100 / totalCount) : 0)%</small>
                                </div>
                            </div>
                        </div>
                    </a>
                </div>
            }
        </div>
    }
</div>