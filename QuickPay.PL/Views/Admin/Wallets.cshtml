@using QuickPay.BLL.DTOs.Admin
@model IEnumerable<AdminWalletDto>

@{
    ViewData["Title"] = "All Wallets";
}

<div class="container py-5">

    <h2 class="mb-4">All Wallets</h2>

    @if (TempData["SuccessMessage"] is not null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }

    <table class="table align-middle">
        <thead>
            <tr>
                <th>Name</th>
                <th>Type</th>
                <th>Owner / Members</th>
                <th>Balance</th>
                <th>Status</th>
                <th>Created</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var wallet in Model)
            {
                <tr>
                    <td>@wallet.Name</td>
                    <td>
                        <span class="badge @(wallet.Type == "Personal" ? "bg-secondary" : "bg-info text-dark")">
                            @wallet.Type
                        </span>
                    </td>
                    <td>@wallet.OwnerDisplay</td>
                    <td>@wallet.Balance.ToString("N2") @wallet.Currency</td>
                    <td>
                        @if (wallet.IsActive)
                        {
                            <span class="badge bg-success">Active</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Blocked</span>
                        }
                    </td>
                    <td>@wallet.CreatedAt.ToString("d MMM yyyy")</td>
                    <td>
                        <form asp-action="ToggleWalletActive" asp-controller="Admin" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@wallet.Id" />
                            <input type="hidden" name="isShared" value="@wallet.IsShared.ToString().ToLower()" />
                            <button type="submit" class="btn btn-sm @(wallet.IsActive ? "btn-outline-danger" : "btn-outline-success")">
                                @(wallet.IsActive ? "Block" : "Activate")
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>

</div>
