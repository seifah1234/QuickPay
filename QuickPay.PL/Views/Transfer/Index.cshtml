@using QuickPay.BLL.ViewModels
@model TransferViewModel

@{
    ViewData["Title"] = "Transfer Money";
}

<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-md-6">

            <div class="card shadow-sm border-0">

                <div class="card-body p-4">

                    <h2 class="mb-1">
                        Transfer Money
                    </h2>

                    <p class="text-muted mb-4">
                        Transfer money between financial accounts.
                    </p>


                    @if (TempData["SuccessMessage"] is not null)
                    {
                        <div class="alert alert-success">
                            @TempData["SuccessMessage"]
                        </div>
                    }


                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3">
                    </div>


                    <form asp-action="Index"
                          asp-controller="Transfer"
                          method="post">

                        @Html.AntiForgeryToken()


                        <!-- From Account -->

                        <div class="mb-3">

                            <label asp-for="FromAccountId"
                                   class="form-label">
                                From Account
                            </label>

                            <select asp-for="FromAccountId"
                                    class="form-select">

                                <option value="0">
                                    Select source account
                                </option>

                                @foreach (var account in Model.Accounts)
                                {
                                    <option value="@account.Id">
                                        @account.DisplayName
                                        -
                                        @account.Balance.ToString("N2")
                                        @account.Currency
                                    </option>
                                }

                            </select>

                            <span asp-validation-for="FromAccountId"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- To Account -->

                        <div class="mb-3">

                            <label asp-for="ToAccountId"
                                   class="form-label">
                                To Account
                            </label>

                            <select asp-for="ToAccountId"
                                    class="form-select">

                                <option value="0">
                                    Select destination account
                                </option>

                                @foreach (var account in Model.Accounts)
                                {
                                    <option value="@account.Id">
                                        @account.DisplayName
                                    </option>
                                }

                            </select>

                            <span asp-validation-for="ToAccountId"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- Amount -->

                        <div class="mb-4">

                            <label asp-for="Amount"
                                   class="form-label">
                                Amount
                            </label>

                            <div class="input-group">

                                <input asp-for="Amount"
                                       class="form-control"
                                       placeholder="0.00"
                                       step="0.01" />

                                <span class="input-group-text">
                                    EGP
                                </span>

                            </div>

                            <span asp-validation-for="Amount"
                                  class="text-danger">
                            </span>

                        </div>


                        <button type="submit"
                                class="btn btn-primary w-100">

                            Transfer Money

                        </button>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>


@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}