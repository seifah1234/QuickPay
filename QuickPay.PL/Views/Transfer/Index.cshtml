@using QuickPay.BLL.ViewModels
@model TransferViewModel

@{
    ViewData["Title"] = "Transfer Money";
}

<div class="container py-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <div>
            <h1 class="qp-dashboard-title mb-1">Transfer Money</h1>
            <p class="text-muted mb-0">Send money instantly between financial accounts.</p>
        </div>
        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">
            <svg width="16" height="16" fill="currentColor" viewBox="0 0 16 16" class="me-2">
                <path fill-rule="evenodd" d="M15 8a.5.5 0 0 0-.5-.5H2.707l3.147-3.146a.5.5 0 1 0-.708-.708l-4 4a.5.5 0 0 0 0 .708l4 4a.5.5 0 0 0 .708-.708L2.707 8.5H14.5A.5.5 0 0 0 15 8z" />
            </svg>
            Back to Dashboard
        </a>
    </div>

    <!-- Alerts -->
    @if (TempData["SuccessMessage"] is not null)
    {
        <div class="alert alert-success d-flex align-items-center mb-4" role="alert">
            <svg width="18" height="18" fill="currentColor" viewBox="0 0 16 16" class="me-2 flex-shrink-0">
                <path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0zm-3.97-3.03a.75.75 0 0 0-1.08.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-.01-1.05z" />
            </svg>
            <span>@TempData["SuccessMessage"]</span>
        </div>
    }

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card qp-transfer-card">
                <div class="card-header bg-transparent border-bottom py-3">
                    <h5 class="mb-0">
                        <svg width="18" height="18" fill="currentColor" viewBox="0 0 16 16" class="me-2">
                            <path fill-rule="evenodd" d="M1 8a.5.5 0 0 1 .5-.5h11.793l-3.147-3.146a.5.5 0 0 1 .708-.708l4 4a.5.5 0 0 1 0 .708l-4 4a.5.5 0 0 1-.708-.708L13.293 8.5H1.5A.5.5 0 0 1 1 8z" />
                        </svg>
                        Transfer Details
                    </h5>
                </div>
                <div class="card-body p-4">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <form asp-action="Index" asp-controller="Transfer" method="post">
                        @Html.AntiForgeryToken()

                        <!-- From Account -->
                        <div class="mb-4">
                            <label asp-for="FromAccountId" class="form-label">
                                From Account
                            </label>
                            <div class="input-group">
                                <span class="input-group-text">
                                    <svg width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                                        <path d="M0 4a1 1 0 0 1 1-1h14a1 1 0 0 1 1 1v8a1 1 0 0 1-1 1H1a1 1 0 0 1-1-1V4Zm1 0v1h14V4H1Zm14 2H1v5h14V6ZM2 9.5a.5.5 0 0 1 .5-.5h2a.5.5 0 0 1 0 1h-2a.5.5 0 0 1-.5-.5Zm0 2a.5.5 0 0 1 .5-.5h2a.5.5 0 0 1 0 1h-2a.5.5 0 0 1-.5-.5Z" />
                                    </svg>
                                </span>
                                <select asp-for="FromAccountId" class="form-select">
                                    <option value="0">Select source account</option>
                                    @foreach (var account in Model.Accounts)
                                    {
                                        <option value="@account.Id">
                                            @account.DisplayName - @account.Balance.ToString("N2") @account.Currency
                                        </option>
                                    }
                                </select>
                            </div>
                            <span asp-validation-for="FromAccountId" class="text-danger"></span>
                        </div>

                        <!-- Transfer Direction Indicator -->
                        <div class="qp-transfer-arrow mb-4">
                            <svg width="24" height="24" fill="currentColor" viewBox="0 0 16 16">
                                <path fill-rule="evenodd" d="M8 3a.5.5 0 0 1 .5.5v9a.5.5 0 0 1-1 0v-9A.5.5 0 0 1 8 3z" />
                                <path fill-rule="evenodd" d="M8 12.5a.5.5 0 0 1-.5-.5V3a.5.5 0 0 1 1 0v9a.5.5 0 0 1-.5.5z" />
                            </svg>
                        </div>

                        <!-- To Account -->
                        <div class="mb-4">
                            <label for="recipientSearch" class="form-label">
                                To (username, phone number, or shared wallet)
                            </label>
                            <div class="input-group">
                                <span class="input-group-text">
                                    <svg width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                                        <path d="M15 14s1 0 1-1-1-4-5-4-5 3-5 4 1 1 1 1h8Zm-7.978-1A.261.261 0 0 1 7 12.996c.001-.264.167-1.03.76-1.72C8.312 10.629 9.282 10 11 10c1.717 0 2.687.63 3.24 1.276.593.69.758 1.457.76 1.72l-.008.002a.274.274 0 0 1-.014.002H7.022ZM11 7a2 2 0 1 0 0-4 2 2 0 0 0 0 4Zm3-2a3 3 0 1 1-6 0 3 3 0 0 1 6 0ZM6.936 9.28a5.88 5.88 0 0 0-1.23-.247A7.35 7.35 0 0 0 5 9c-4 0-5 3-5 4 0 .667.333 1 1 1h4.216A2.238 2.238 0 0 1 5 13c0-1.01.377-2.042 1.09-2.904.243-.294.526-.569.846-.816ZM4.92 10A5.493 5.493 0 0 0 4 13H1c0-.26.164-1.03.76-1.724.545-.636 1.492-1.256 3.16-1.275ZM1.5 5.5a3 3 0 1 1 6 0 3 3 0 0 1-6 0Zm3-2a2 2 0 1 0 0 4 2 2 0 0 0 0-4Z" />
                                    </svg>
                                </span>
                                <input type="text" id="recipientSearch" class="form-control" autocomplete="off"
                                       placeholder="Start typing to search..." value="@Model.ToAccountDisplay" />
                            </div>
                            <div id="recipientResults" class="list-group mt-1"></div>
                            <input asp-for="ToAccountId" type="hidden" id="ToAccountIdInput" />
                            <span asp-validation-for="ToAccountId" class="text-danger"></span>
                        </div>

                        <!-- Amount -->
                        <div class="mb-4">
                            <label asp-for="Amount" class="form-label">
                                Amount
                            </label>
                            <div class="input-group input-group-lg">
                                <span class="input-group-text">
                                    <svg width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                                        <path d="M8 1a2 2 0 0 1 2 2v4H6V3a2 2 0 0 1 2-2zm3 6V3a3 3 0 0 0-6 0v4a2 2 0 0 0-2 2v5a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2z" />
                                    </svg>
                                </span>
                                <input asp-for="Amount" class="form-control qp-amount-input" placeholder="0.00" step="0.01" />
                                <span class="input-group-text">EGP</span>
                            </div>
                            <span asp-validation-for="Amount" class="text-danger"></span>
                        </div>

                        <!-- Submit Button -->
                        <button type="submit" class="btn btn-primary w-100 btn-lg">
                            <svg width="18" height="18" fill="currentColor" viewBox="0 0 16 16" class="me-2">
                                <path fill-rule="evenodd" d="M1 8a.5.5 0 0 1 .5-.5h11.793l-3.147-3.146a.5.5 0 0 1 .708-.708l4 4a.5.5 0 0 1 0 .708l-4 4a.5.5 0 0 1-.708-.708L13.293 8.5H1.5A.5.5 0 0 1 1 8z" />
                            </svg>
                            Transfer Money
                        </button>
                    </form>
                </div>
            </div>

            <!-- Quick Tips -->
            <div class="card qp-tips-card mt-3">
                <div class="card-body p-3">
                    <div class="d-flex align-items-center">
                        <svg width="20" height="20" fill="currentColor" viewBox="0 0 16 16" class="me-2 text-warning">
                            <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14zm0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16z" />
                            <path d="M7.002 11a1 1 0 1 1 2 0 1 1 0 0 1-2 0zM7.1 4.995a.905.905 0 1 1 1.8 0l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 4.995z" />
                        </svg>
                        <span class="text-muted small">Transfers are instant and free between QuickPay accounts.</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/transfer-recipient-search.js"></script>
}