@using QuickPay.BLL.ViewModels.Auth
@model VerifyOtpViewModel
@{
    Layout = "_EmptyLayout";
    ViewData["Title"] = "Verify Phone";
}

<div class="auth-wrapper">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-5 col-lg-4">
                <div class="card auth-card">
                    <div class="card-body">

                        <div class="text-center mb-4">
                            <div class="auth-logo-wrapper mb-4">
                                <div class="auth-logo-container p-0">
                                    <img src="~/img/icon.png" alt="QuickPay Logo" style="width:100px;margin: 0;" />
                                </div>
                            </div>
                            <h2>Verify Your Phone</h2>
                            <p class="text-muted">
                                We sent a 6-digit code to your phone number.
                            </p>
                        </div>

                        @if (TempData["InfoMessage"] is not null)
                        {
                            <div class="alert alert-info d-flex align-items-center" role="alert">
                                <svg width="18" height="18" fill="currentColor" viewBox="0 0 16 16" class="me-2 flex-shrink-0">
                                    <path d="M8 16A8 8 0 1 0 8 0a8 8 0 0 0 0 16zm.93-9.412-1 4.705c-.07.34.029.533.304.533.194 0 .487-.07.686-.246l-.088.416c-.287.346-.92.598-1.465.598-.703 0-1.002-.422-.808-1.319l.738-3.468c.064-.293.006-.399-.287-.47l-.451-.081.082-.381 2.29-.287zM8 5.5a1 1 0 1 1 0-2 1 1 0 0 1 0 2z" />
                                </svg>
                                <span>@TempData["InfoMessage"]</span>
                            </div>
                        }

                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <form asp-action="VerifyOtp" asp-controller="Auth" method="post">
                            @Html.AntiForgeryToken()

                            <input asp-for="UserId" type="hidden" />

                            <div class="mb-4">
                                <label asp-for="Code" class="form-label text-center d-block">
                                    Verification Code
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text">
                                        <svg width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                                            <path d="M10.97 4.97a.75.75 0 0 1 1.07 1.05l-3.99 4.99a.75.75 0 0 1-1.08.02L4.324 8.384a.75.75 0 1 1 1.06-1.06l2.094 2.093 3.473-4.425a.267.267 0 0 1 .02-.022z" />
                                        </svg>
                                    </span>
                                    <input asp-for="Code" class="form-control text-center otp-input"
                                           maxlength="6" autocomplete="one-time-code"
                                           inputmode="numeric" pattern="[0-9]*"
                                           placeholder="••••••" />
                                </div>
                                <span asp-validation-for="Code" class="text-danger"></span>
                            </div>

                            <button type="submit" class="btn btn-primary w-100 mb-3">
                                Verify
                                <svg width="16" height="16" fill="currentColor" viewBox="0 0 16 16" class="ms-2">
                                    <path fill-rule="evenodd" d="M13.854 3.646a.5.5 0 0 1 0 .708l-7 7a.5.5 0 0 1-.708 0l-3.5-3.5a.5.5 0 1 1 .708-.708L6.5 10.293l6.646-6.647a.5.5 0 0 1 .708 0z" />
                                </svg>
                            </button>

                            <div class="text-center">
                                <p class="text-muted mb-0 small">
                                    Didn't receive the code?
                                    <a href="#" class="text-decoration-none">Resend Code</a>
                                </p>
                            </div>
                        </form>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const otpInput = document.querySelector('.otp-input');
            if (otpInput) {
                otpInput.focus();
            }
        });

        document.querySelector('.otp-input')?.addEventListener('input', function(e) {
            this.value = this.value.replace(/[^0-9]/g, '');
        });
    </script>
}