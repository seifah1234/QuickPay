@using QuickPay.DAL.UnitOfWork
@using System.Security.Claims
@using System.IdentityModel.Tokens.Jwt
@inject IUnitOfWork UnitOfWork
@{
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    bool needsPhone = false;
    if (isAuthenticated)
    {
        var subClaim = User.FindFirst(JwtRegisteredClaimNames.Sub)?.Value 
                    ?? User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        if (int.TryParse(subClaim, out var currentUserId))
        {
            var userEntity = await UnitOfWork.Users.GetByIdAsync(currentUserId);
            if (userEntity != null && (string.IsNullOrWhiteSpace(userEntity.PhoneNumber) || !userEntity.IsPhoneVerified))
            {
                needsPhone = true;
            }
        }
    }
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - QuickPay</title>
    <script type="importmap"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@500;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/QuickPay.PL.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark mb-4">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">QuickPay</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Wallet" asp-action="Index">Wallets</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Transfer" asp-action="Index">Transfer</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="TransactionHistory" asp-action="Index">History</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Notifications" asp-action="Index">Notifications</a>
                        </li>
                    </ul>
                    <ul class="navbar-nav">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Auth" asp-action="Login">Log in</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    @if (needsPhone)
    {
        <div class="container mb-3">
            <div class="alert alert-warning d-flex align-items-center justify-content-between shadow-sm mb-0" role="alert">
                <div>
                    <strong>Action Required:</strong> Your account does not have a verified phone number. Please add your phone number to secure your account.
                </div>
                <a asp-controller="Auth" asp-action="AddPhoneNumber" class="btn btn-warning btn-sm ms-3 text-nowrap">
                    Add Phone Number
                </a>
            </div>
        </div>
    }

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container py-3">
            &copy; 2026 - QuickPay
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
