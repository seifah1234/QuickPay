@using QuickPay.DAL.UnitOfWork
@using System.Security.Claims
@using System.IdentityModel.Tokens.Jwt
@inject IUnitOfWork UnitOfWork
@inject QuickPay.DAL.UnitOfWork.IUnitOfWork UnitOfWork
@inject QuickPay.BLL.Services.Interfaces.ICurrentUserService CurrentUserService

@{
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    bool needsPhone = false;
    if (isAuthenticated)
    {
        var subClaim = User.FindFirst(JwtRegisteredClaimNames.Sub)?.Value 
                    ?? User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        if (int.TryParse(subClaim, out var currentUserId))
        {
            var userEntity = await UnitOfWork.Users.GetByIdAsync(currentUserId);
            if (userEntity != null && (string.IsNullOrWhiteSpace(userEntity.PhoneNumber) || !userEntity.IsPhoneVerified))
            {
                needsPhone = true;
            }
        }
    }
}
@{
    bool isAdmin = false;
    string? currentUserName = null;
    string? currentUserImage = null;

    if (User.Identity?.IsAuthenticated == true)
    {
        var currentUserId = CurrentUserService.GetCurrentUserId();
        var currentUser = await UnitOfWork.Users.GetByIdAsync(currentUserId);
        isAdmin = currentUser?.IsAdmin ?? false;
        currentUserName = currentUser?.UserName;
        currentUserImage = currentUser?.ProfilePhotoUrl;
    }
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - QuickPay</title>
    <script type="importmap"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@500;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/QuickPay.PL.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark mb-4">
            <div class="container-fluid px-4">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <span class="brand-icon"></span>
                    QuickPay
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">

                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" id="walletsDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <svg width="16" height="16" fill="currentColor" viewBox="0 0 16 16" class="me-1">
                                    <path d="M0 4a1 1 0 0 1 1-1h14a1 1 0 0 1 1 1v8a1 1 0 0 1-1 1H1a1 1 0 0 1-1-1V4Zm1 0v1h14V4H1Zm14 2H1v5h14V6ZM2 9.5a.5.5 0 0 1 .5-.5h2a.5.5 0 0 1 0 1h-2a.5.5 0 0 1-.5-.5Zm0 2a.5.5 0 0 1 .5-.5h2a.5.5 0 0 1 0 1h-2a.5.5 0 0 1-.5-.5Z" />
                                </svg>
                                Wallets
                            </a>
                            <ul class="dropdown-menu" aria-labelledby="walletsDropdown">
                                <li><a class="dropdown-item" asp-area="" asp-controller="Wallet" asp-action="Index">My Wallets</a></li>
                                <li><a class="dropdown-item" asp-area="" asp-controller="SharedWallet" asp-action="Index">Shared Wallets</a></li>
                                <li><a class="dropdown-item" asp-area="" asp-controller="LinkedAccounts" asp-action="Index">Linked Accounts</a></li>
                            </ul>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" id="paymentsDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <svg width="16" height="16" fill="currentColor" viewBox="0 0 16 16" class="me-1">
                                    <path fill-rule="evenodd" d="M1 8a.5.5 0 0 1 .5-.5h11.793l-3.147-3.146a.5.5 0 0 1 .708-.708l4 4a.5.5 0 0 1 0 .708l-4 4a.5.5 0 0 1-.708-.708L13.293 8.5H1.5A.5.5 0 0 1 1 8z" />
                                </svg>
                                Payments
                            </a>
                            <ul class="dropdown-menu" aria-labelledby="paymentsDropdown">
                                <li><a class="dropdown-item" asp-area="" asp-controller="Transfer" asp-action="Index">Transfer</a></li>
                                <li><a class="dropdown-item" asp-area="" asp-controller="SmartSplit" asp-action="Index">Smart Split</a></li>
                                <li><a class="dropdown-item" asp-area="" asp-controller="TransactionHistory" asp-action="Index">Transaction History</a></li>
                            </ul>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Notifications" asp-action="Index">
                                <svg width="16" height="16" fill="currentColor" viewBox="0 0 16 16" class="me-1">
                                    <path d="M8 16a2 2 0 0 0 2-2H6a2 2 0 0 0 2 2zM8 1.918l-.797.161A4.002 4.002 0 0 0 4 6c0 .628-.134 2.197-.459 3.742-.16.767-.376 1.566-.663 2.258h10.244c-.287-.692-.502-1.49-.663-2.258C12.134 8.197 12 6.628 12 6a4.002 4.002 0 0 0-3.203-3.92L8 1.917zM14.22 12c.223.447.481.801.78 1H1c.299-.199.557-.553.78-1C2.68 10.2 3 9.073 3 8c0-2.754 1.781-5.05 4.258-5.74A2 2 0 1 1 9.742 2.26C12.219 2.95 14 5.246 14 8c0 1.073.32 2.2 1.22 4z" />
                                </svg>
                                Notifications
                                <span class="badge rounded-pill bg-warning text-dark ms-1">3</span>
                            </a>
                        </li>
                        @if (isAdmin)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Admin" asp-action="Index">
                                    <svg width="16" height="16" fill="currentColor" viewBox="0 0 16 16" class="me-1">
                                        <path d="M8 16A8 8 0 1 0 8 0a8 8 0 0 0 0 16zM8 4a1 1 0 0 1 1 1v3.586l2.707 2.707a1 1 0 0 1-1.414 1.414L7 9.414V5a1 1 0 0 1 1-1z" />
                                    </svg>
                                    Admin Dashboard
                                </a>
                            </li>
                        }
                    </ul>
                    <ul class="navbar-nav">
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle d-flex align-items-center" href="#" id="userMenuDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                @if (string.IsNullOrEmpty(currentUserImage))
                                {
                                    <span class="qp-avatar me-2">@((currentUserName ?? "?").Substring(0, 1).ToUpper())</span>

                                }
                                else
                                {
                                    <img class="rounded-circle me-2" style="width:50px;height:50px;object-fit:cover;" src="@currentUserImage" alt="@((currentUserName ?? "?").Substring(0, 1).ToUpper())" />

                                }
                                @(currentUserName ?? "Account")
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userMenuDropdown">
                                <li><h6 class="dropdown-header">Signed in as @currentUserName</h6></li>
                                <li><a class="dropdown-item" asp-controller="Profile" asp-action="Index">My Profile</a></li>
                                <li><hr class="dropdown-divider" /></li>
                                <li>
                                    <form asp-action="Logout" asp-controller="Auth" method="post">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="dropdown-item qp-logout-btn">
                                            <svg width="16" height="16" fill="currentColor" viewBox="0 0 16 16" class="me-2">
                                                <path fill-rule="evenodd" d="M10 12.5a.5.5 0 0 1-.5.5h-8a.5.5 0 0 1-.5-.5v-9a.5.5 0 0 1 .5-.5h8a.5.5 0 0 1 .5.5v2a.5.5 0 0 0 1 0v-2A1.5 1.5 0 0 0 9.5 2h-8A1.5 1.5 0 0 0 0 3.5v9A1.5 1.5 0 0 0 1.5 14h8a1.5 1.5 0 0 0 1.5-1.5v-2a.5.5 0 0 0-1 0v2z" />
                                                <path fill-rule="evenodd" d="M15.854 8.354a.5.5 0 0 0 0-.708l-3-3a.5.5 0 0 0-.708.708L14.293 7.5H5.5a.5.5 0 0 0 0 1h8.793l-2.147 2.146a.5.5 0 0 0 .708.708l3-3z" />
                                            </svg>
                                            Log Out
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </li>
                    </ul>

                </div>
            </div>
        </nav>
    </header>

    @if (needsPhone)
    {
        <div class="container mb-3">
            <div class="alert alert-warning d-flex align-items-center justify-content-between shadow-sm mb-0" role="alert">
                <div>
                    <strong>Action Required:</strong> Your account does not have a verified phone number. Please add your phone number to secure your account.
                </div>
                <a asp-controller="Auth" asp-action="AddPhoneNumber" class="btn btn-warning btn-sm ms-3 text-nowrap">
                    Add Phone Number
                </a>
            </div>
        </div>
    }

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container py-3">
            &copy; 2026 - QuickPay
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>