diff --git a/QuickPay.PL/wwwroot/css/animations.css b/QuickPay.PL/wwwroot/css/animations.css
new file mode 100644
index 0000000..d44ed88
--- /dev/null
+++ b/QuickPay.PL/wwwroot/css/animations.css
@@ -0,0 +1,182 @@
+/* ============================================================
+   QuickPay Animations
+   Subtle, fast, professional. Everything respects
+   prefers-reduced-motion at the bottom of this file.
+   ============================================================ */
+
+@keyframes qp-fade-in-up {
+    from {
+        opacity: 0;
+        transform: translateY(10px);
+    }
+
+    to {
+        opacity: 1;
+        transform: translateY(0);
+    }
+}
+
+@keyframes qp-fade-in {
+    from {
+        opacity: 0;
+    }
+
+    to {
+        opacity: 1;
+    }
+}
+
+@keyframes qp-scale-in {
+    from {
+        opacity: 0;
+        transform: scale(0.97);
+    }
+
+    to {
+        opacity: 1;
+        transform: scale(1);
+    }
+}
+
+@keyframes qp-shimmer {
+    0% {
+        background-position: -200% 0;
+    }
+
+    100% {
+        background-position: 200% 0;
+    }
+}
+
+/* -------------------- entrance animations -------------------- */
+/* Applied via JS (ui.js observes .qp-reveal elements and adds
+   .qp-reveal-in when they scroll into view / on page load). */
+
+.qp-reveal {
+    opacity: 0;
+}
+
+.qp-reveal-in {
+    animation: qp-fade-in-up var(--qp-t-slow, 380ms) var(--qp-ease, ease) forwards;
+}
+
+/* Staggered children: add .qp-stagger to a container; each direct
+   child gets an incremental delay via nth-child, capped at 10. */
+.qp-stagger > * {
+    opacity: 0;
+}
+
+.qp-stagger.qp-reveal-in > * {
+    animation: qp-fade-in-up var(--qp-t-slow, 380ms) var(--qp-ease, ease) forwards;
+}
+
+    .qp-stagger.qp-reveal-in > *:nth-child(1) {
+        animation-delay: 0ms;
+    }
+
+    .qp-stagger.qp-reveal-in > *:nth-child(2) {
+        animation-delay: 60ms;
+    }
+
+    .qp-stagger.qp-reveal-in > *:nth-child(3) {
+        animation-delay: 120ms;
+    }
+
+    .qp-stagger.qp-reveal-in > *:nth-child(4) {
+        animation-delay: 180ms;
+    }
+
+    .qp-stagger.qp-reveal-in > *:nth-child(5) {
+        animation-delay: 240ms;
+    }
+
+    .qp-stagger.qp-reveal-in > *:nth-child(6) {
+        animation-delay: 300ms;
+    }
+
+    .qp-stagger.qp-reveal-in > *:nth-child(n+7) {
+        animation-delay: 360ms;
+    }
+
+/* -------------------- page transition -------------------- */
+
+.qp-page-enter {
+    animation: qp-fade-in var(--qp-t-base, 220ms) var(--qp-ease, ease) both;
+}
+
+/* -------------------- hover interactions -------------------- */
+
+.qp-hover-lift {
+    transition: transform var(--qp-t-base, 220ms) var(--qp-ease, ease),
+        box-shadow var(--qp-t-base, 220ms) var(--qp-ease, ease);
+}
+
+    .qp-hover-lift:hover {
+        transform: translateY(-3px);
+    }
+
+/* Very subtle 3D tilt - meant for dashboard/wallet cards.
+   Pairs with a tiny bit of JS (ui.js) that sets --tilt-x/--tilt-y
+   from the mouse position; degrades gracefully to flat if JS
+   doesn't run. */
+.qp-tilt {
+    transform: perspective(800px)
+        rotateX(var(--tilt-y, 0deg))
+        rotateY(var(--tilt-x, 0deg));
+    transition: transform var(--qp-t-fast, 150ms) var(--qp-ease, ease);
+    transform-style: preserve-3d;
+}
+
+/* -------------------- skeleton loading -------------------- */
+
+.qp-skeleton {
+    position: relative;
+    overflow: hidden;
+    background: var(--qp-line-soft, #eef2f6);
+    border-radius: var(--qp-radius-sm, 10px);
+    background-image: linear-gradient( 90deg, rgba(255,255,255,0) 0%, rgba(255,255,255,0.7) 50%, rgba(255,255,255,0) 100% );
+    background-size: 200% 100%;
+    animation: qp-shimmer 1.4s ease-in-out infinite;
+}
+
+/* -------------------- sidebar / off-canvas transitions -------------------- */
+
+.qp-sidebar {
+    transition: width var(--qp-t-base, 220ms) var(--qp-ease, ease),
+        transform var(--qp-t-base, 220ms) var(--qp-ease, ease);
+}
+
+.qp-sidebar-backdrop {
+    opacity: 0;
+    pointer-events: none;
+    transition: opacity var(--qp-t-base, 220ms) var(--qp-ease, ease);
+}
+
+    .qp-sidebar-backdrop.qp-show {
+        opacity: 1;
+        pointer-events: auto;
+    }
+
+/* -------------------- reduced motion -------------------- */
+
+@media (prefers-reduced-motion: reduce) {
+    .qp-reveal,
+    .qp-stagger > * {
+        opacity: 1 !important;
+        animation: none !important;
+    }
+
+    .qp-reveal-in,
+    .qp-page-enter,
+    .qp-skeleton {
+        animation: none !important;
+    }
+
+    .qp-tilt {
+        transform: none !important;
+    }
+
+    * {
+        transition-duration: 1ms !important;
+    }
+}
diff --git a/QuickPay.PL/wwwroot/css/components.css b/QuickPay.PL/wwwroot/css/components.css
new file mode 100644
index 0000000..f82ac35
--- /dev/null
+++ b/QuickPay.PL/wwwroot/css/components.css
@@ -0,0 +1,238 @@
+/* ============================================================
+   QuickPay Components
+   Sidebar navigation, topbar, and the mobile off-canvas variant.
+   ============================================================ */
+
+body.qp-app {
+    display: flex;
+    flex-direction: row;
+    align-items: stretch;
+    min-height: 100vh;
+}
+
+/* -------------------- sidebar -------------------- */
+
+.qp-sidebar {
+    width: var(--qp-sidebar-w);
+    flex-shrink: 0;
+    background: linear-gradient(180deg, var(--qp-sidebar-bg) 0%, var(--qp-sidebar-bg-soft) 100%);
+    color: var(--qp-sidebar-text);
+    display: flex;
+    flex-direction: column;
+    position: sticky;
+    top: 0;
+    height: 100vh;
+    z-index: 1030;
+}
+
+.qp-sidebar-brand {
+    display: flex;
+    align-items: center;
+    gap: .6rem;
+    padding: 1.25rem 1.25rem;
+    color: #fff;
+    font-family: var(--qp-font-display);
+    font-weight: 700;
+    font-size: 1.15rem;
+    border-bottom: 1px solid var(--qp-sidebar-line);
+    flex-shrink: 0;
+}
+
+.qp-sidebar-brand-icon {
+    width: 34px;
+    height: 34px;
+    border-radius: 10px;
+    background: linear-gradient(135deg, #6366f1 0%, #f59e0b 100%);
+    flex-shrink: 0;
+}
+
+.qp-sidebar-nav {
+    flex: 1 1 auto;
+    overflow-y: auto;
+    padding: 1rem .75rem;
+    list-style: none;
+    margin: 0;
+}
+
+.qp-sidebar-section-label {
+    font-size: .7rem;
+    text-transform: uppercase;
+    letter-spacing: .08em;
+    color: rgba(255, 255, 255, 0.35);
+    padding: .9rem .75rem .35rem;
+}
+
+.qp-sidebar-link {
+    display: flex;
+    align-items: center;
+    gap: .75rem;
+    padding: .6rem .75rem;
+    border-radius: var(--qp-radius-sm, 10px);
+    color: var(--qp-sidebar-text);
+    font-weight: 500;
+    font-size: .92rem;
+    text-decoration: none;
+    transition: background var(--qp-t-fast) var(--qp-ease), color var(--qp-t-fast) var(--qp-ease);
+    margin-bottom: .15rem;
+}
+
+    .qp-sidebar-link svg {
+        flex-shrink: 0;
+        opacity: .85;
+    }
+
+    .qp-sidebar-link:hover {
+        background: rgba(255, 255, 255, 0.06);
+        color: var(--qp-sidebar-text-active);
+    }
+
+    .qp-sidebar-link.active {
+        background: linear-gradient(135deg, rgba(99, 102, 241, 0.35) 0%, rgba(99, 102, 241, 0.15) 100%);
+        color: #fff;
+        box-shadow: inset 0 0 0 1px rgba(99, 102, 241, 0.4);
+    }
+
+.qp-sidebar-footer {
+    padding: 1rem;
+    border-top: 1px solid var(--qp-sidebar-line);
+    flex-shrink: 0;
+}
+
+/* collapsed (desktop icon-only) state */
+body.qp-sidebar-collapsed .qp-sidebar {
+    width: var(--qp-sidebar-w-collapsed);
+}
+
+body.qp-sidebar-collapsed .qp-sidebar-brand span.qp-sidebar-brand-text,
+body.qp-sidebar-collapsed .qp-sidebar-link span,
+body.qp-sidebar-collapsed .qp-sidebar-section-label {
+    display: none;
+}
+
+body.qp-sidebar-collapsed .qp-sidebar-link {
+    justify-content: center;
+}
+
+/* -------------------- main column -------------------- */
+
+.qp-main-col {
+    flex: 1 1 auto;
+    min-width: 0;
+    display: flex;
+    flex-direction: column;
+}
+
+/* -------------------- topbar -------------------- */
+
+.qp-topbar {
+    height: var(--qp-topbar-h);
+    display: flex;
+    align-items: center;
+    justify-content: space-between;
+    gap: 1rem;
+    padding: 0 1.5rem;
+    position: sticky;
+    top: 0;
+    z-index: 1020;
+    border-bottom: 1px solid var(--qp-line);
+}
+
+.qp-topbar-toggle {
+    background: none;
+    border: none;
+    color: var(--qp-ink-soft);
+    padding: .4rem;
+    border-radius: var(--qp-radius-sm);
+    display: inline-flex;
+    align-items: center;
+    justify-content: center;
+    transition: background var(--qp-t-fast) var(--qp-ease);
+}
+
+    .qp-topbar-toggle:hover {
+        background: var(--qp-line-soft);
+    }
+
+.qp-topbar-actions {
+    display: flex;
+    align-items: center;
+    gap: .5rem;
+}
+
+.qp-notif-btn {
+    position: relative;
+    display: inline-flex;
+    align-items: center;
+    justify-content: center;
+    width: 38px;
+    height: 38px;
+    border-radius: 50%;
+    color: var(--qp-ink-soft);
+    transition: background var(--qp-t-fast) var(--qp-ease);
+}
+
+    .qp-notif-btn:hover {
+        background: var(--qp-line-soft);
+    }
+
+.qp-notif-dot {
+    position: absolute;
+    top: 6px;
+    right: 7px;
+    width: 8px;
+    height: 8px;
+    border-radius: 50%;
+    background: var(--qp-danger);
+    border: 2px solid var(--qp-surface);
+}
+
+/* -------------------- mobile off-canvas -------------------- */
+
+.qp-sidebar-backdrop {
+    position: fixed;
+    inset: 0;
+    background: rgba(20, 20, 43, 0.45);
+    z-index: 1025;
+}
+
+@media (max-width: 991.98px) {
+    .qp-sidebar {
+        position: fixed;
+        left: 0;
+        top: 0;
+        transform: translateX(-100%);
+    }
+
+    body.qp-sidebar-open .qp-sidebar {
+        transform: translateX(0);
+    }
+
+    body.qp-sidebar-collapsed .qp-sidebar {
+        width: var(--qp-sidebar-w);
+    }
+
+    body.qp-sidebar-collapsed .qp-sidebar-brand span.qp-sidebar-brand-text,
+    body.qp-sidebar-collapsed .qp-sidebar-link span,
+    body.qp-sidebar-collapsed .qp-sidebar-section-label {
+        display: initial;
+    }
+}
+
+@media (min-width: 992px) {
+    .qp-sidebar-backdrop {
+        display: none;
+    }
+}
+
+/* -------------------- content container -------------------- */
+
+.qp-content {
+    padding: 1.5rem;
+    flex: 1 0 auto;
+}
+
+@media (max-width: 575.98px) {
+    .qp-content {
+        padding: 1rem;
+    }
+}
diff --git a/QuickPay.PL/wwwroot/css/design-system.css b/QuickPay.PL/wwwroot/css/design-system.css
new file mode 100644
index 0000000..71d0e5e
--- /dev/null
+++ b/QuickPay.PL/wwwroot/css/design-system.css
@@ -0,0 +1,44 @@
+/* ============================================================
+   QuickPay Design System
+   Loaded AFTER site.css - reuses the existing --qp-* palette
+   (brand indigo / gold accent) and adds the tokens needed for
+   the new sidebar layout, glass surfaces, and motion timings.
+   Nothing here duplicates or overrides site.css's core tokens.
+   ============================================================ */
+
+:root {
+    /* -- layout -- */
+    --qp-sidebar-w: 264px;
+    --qp-sidebar-w-collapsed: 76px;
+    --qp-topbar-h: 68px;
+
+    /* -- glass surfaces (used sparingly: sidebar + topbar only) -- */
+    --qp-glass-bg: rgba(255, 255, 255, 0.72);
+    --qp-glass-border: rgba(226, 232, 240, 0.8);
+    --qp-glass-blur: 16px;
+
+    /* -- dark sidebar surface -- */
+    --qp-sidebar-bg: #14142b;
+    --qp-sidebar-bg-soft: #1c1c3a;
+    --qp-sidebar-line: rgba(255, 255, 255, 0.08);
+    --qp-sidebar-text: rgba(255, 255, 255, 0.72);
+    --qp-sidebar-text-active: #ffffff;
+
+    /* -- motion timings (kept short & consistent) -- */
+    --qp-ease: cubic-bezier(0.4, 0, 0.2, 1);
+    --qp-t-fast: 150ms;
+    --qp-t-base: 220ms;
+    --qp-t-slow: 380ms;
+
+    /* -- elevation for floating/glass elements -- */
+    --qp-shadow-glass: 0 8px 32px rgba(20, 20, 43, 0.12);
+}
+
+/* Utility: subtle premium glass surface, used only on the
+   sidebar + topbar so the effect stays an accent, not a theme. */
+.qp-glass {
+    background: var(--qp-glass-bg);
+    backdrop-filter: blur(var(--qp-glass-blur));
+    -webkit-backdrop-filter: blur(var(--qp-glass-blur));
+    border: 1px solid var(--qp-glass-border);
+}
diff --git a/QuickPay.PL/wwwroot/js/animations.js b/QuickPay.PL/wwwroot/js/animations.js
new file mode 100644
index 0000000..ac14d7a
--- /dev/null
+++ b/QuickPay.PL/wwwroot/js/animations.js
@@ -0,0 +1,77 @@
+// QuickPay animation helpers.
+// 1) Reveal-on-load/scroll for anything marked .qp-reveal
+//    (or .qp-stagger, whose children cascade via CSS nth-child delays).
+// 2) A small animateCount() utility pages can call for balances
+//    and stats - e.g. animateCount(el, 0, 12500.50, 800).
+(function () {
+    "use strict";
+
+    function initReveal() {
+        var targets = document.querySelectorAll(".qp-reveal, .qp-stagger");
+        if (!targets.length) return;
+
+        if (!("IntersectionObserver" in window)) {
+            targets.forEach(function (el) { el.classList.add("qp-reveal-in"); });
+            return;
+        }
+
+        var observer = new IntersectionObserver(function (entries, obs) {
+            entries.forEach(function (entry) {
+                if (entry.isIntersecting) {
+                    entry.target.classList.add("qp-reveal-in");
+                    obs.unobserve(entry.target);
+                }
+            });
+        }, { threshold: 0.1 });
+
+        targets.forEach(function (el) { observer.observe(el); });
+    }
+
+    function animateCount(el, from, to, durationMs, formatter) {
+        if (!el) return;
+        durationMs = durationMs || 700;
+        formatter = formatter || function (n) {
+            return n.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
+        };
+
+        if (window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
+            el.textContent = formatter(to);
+            return;
+        }
+
+        var start = null;
+
+        function step(timestamp) {
+            if (start === null) start = timestamp;
+            var progress = Math.min((timestamp - start) / durationMs, 1);
+            // ease-out cubic
+            var eased = 1 - Math.pow(1 - progress, 3);
+            var current = from + (to - from) * eased;
+            el.textContent = formatter(current);
+            if (progress < 1) {
+                window.requestAnimationFrame(step);
+            } else {
+                el.textContent = formatter(to);
+            }
+        }
+
+        window.requestAnimationFrame(step);
+    }
+
+    // Auto-run for any element with data-qp-count-to="1234.56".
+    function initAutoCounters() {
+        var counters = document.querySelectorAll("[data-qp-count-to]");
+        counters.forEach(function (el) {
+            var to = parseFloat(el.getAttribute("data-qp-count-to"));
+            if (isNaN(to)) return;
+            animateCount(el, 0, to, 800);
+        });
+    }
+
+    window.QuickPayAnimations = { animateCount: animateCount };
+
+    document.addEventListener("DOMContentLoaded", function () {
+        initReveal();
+        initAutoCounters();
+    });
+})();
diff --git a/QuickPay.PL/wwwroot/js/ui.js b/QuickPay.PL/wwwroot/js/ui.js
new file mode 100644
index 0000000..94aa5cc
--- /dev/null
+++ b/QuickPay.PL/wwwroot/js/ui.js
@@ -0,0 +1,73 @@
+// QuickPay UI interactions: sidebar toggle (desktop collapse + mobile
+// off-canvas) and the subtle card tilt effect. No framework, no
+// dependencies beyond what's already loaded (bootstrap bundle).
+(function () {
+    "use strict";
+
+    var COLLAPSE_KEY = "qp:sidebar-collapsed";
+
+    function initSidebar() {
+        var body = document.body;
+        var toggleBtns = document.querySelectorAll("[data-qp-sidebar-toggle]");
+        var backdrop = document.querySelector(".qp-sidebar-backdrop");
+
+        if (!toggleBtns.length) return;
+
+        // Restore desktop collapsed preference.
+        if (window.innerWidth >= 992 && sessionStorage.getItem(COLLAPSE_KEY) === "1") {
+            body.classList.add("qp-sidebar-collapsed");
+        }
+
+        toggleBtns.forEach(function (btn) {
+            btn.addEventListener("click", function () {
+                if (window.innerWidth < 992) {
+                    // Mobile: off-canvas open/close.
+                    var isOpen = body.classList.toggle("qp-sidebar-open");
+                    if (backdrop) backdrop.classList.toggle("qp-show", isOpen);
+                } else {
+                    // Desktop: icon-only collapse, remembered per tab.
+                    var collapsed = body.classList.toggle("qp-sidebar-collapsed");
+                    sessionStorage.setItem(COLLAPSE_KEY, collapsed ? "1" : "0");
+                }
+            });
+        });
+
+        if (backdrop) {
+            backdrop.addEventListener("click", function () {
+                body.classList.remove("qp-sidebar-open");
+                backdrop.classList.remove("qp-show");
+            });
+        }
+    }
+
+    // Very subtle 3D tilt on elements marked .qp-tilt - reads the
+    // mouse position relative to the card and nudges two CSS
+    // variables that animations.css uses for the rotation. Capped
+    // to a couple of degrees so it stays elegant, not gimmicky.
+    function initTilt() {
+        var cards = document.querySelectorAll(".qp-tilt");
+        if (!cards.length) return;
+
+        var MAX_DEG = 3;
+
+        cards.forEach(function (card) {
+            card.addEventListener("mousemove", function (e) {
+                var rect = card.getBoundingClientRect();
+                var px = (e.clientX - rect.left) / rect.width - 0.5;
+                var py = (e.clientY - rect.top) / rect.height - 0.5;
+                card.style.setProperty("--tilt-x", (px * MAX_DEG * 2).toFixed(2) + "deg");
+                card.style.setProperty("--tilt-y", (py * -MAX_DEG * 2).toFixed(2) + "deg");
+            });
+
+            card.addEventListener("mouseleave", function () {
+                card.style.setProperty("--tilt-x", "0deg");
+                card.style.setProperty("--tilt-y", "0deg");
+            });
+        });
+    }
+
+    document.addEventListener("DOMContentLoaded", function () {
+        initSidebar();
+        initTilt();
+    });
+})();
