# Copy this file to ".env" (same folder as QuickPay.PL.csproj) and fill in your real values.
# ".env" is already in .gitignore - never commit real keys.
# Program.cs loads this file and maps "__" to config-section nesting (Paymob__SecretKey -> Paymob:SecretKey),
# so these override the placeholders in appsettings.json.
#
# --- Paymob ---
# Get these from eg.dashboard.paymob.com/settings/api-keys (Secret key + HMAC)
# and from your Payment Integration's Integration ID.
Paymob__SecretKey=PLACEHOLDER_PAYMOB_SECRET_KEY
Paymob__PublicKey=PLACEHOLDER_PAYMOB_PUBLIC_KEY
Paymob__IntegrationId=PLACEHOLDER_PAYMOB_INTEGRATION_ID
Paymob__HmacSecret=PLACEHOLDER_PAYMOB_HMAC_SECRET

# --- Twilio (real OTP SMS delivery) ---
# Get these from console.twilio.com (Account SID + Auth Token on the
# dashboard home page) and buy/verify a sender number under
# Phone Numbers > Manage > Active Numbers. Until these three are all
# filled in with real values, OTP codes are only logged to the
# console (see TwilioOtpDeliveryService) - nothing breaks, but no
# real SMS goes out.
Twilio__AccountSid=PLACEHOLDER_TWILIO_ACCOUNT_SID
Twilio__AuthToken=PLACEHOLDER_TWILIO_AUTH_TOKEN
Twilio__FromPhoneNumber=PLACEHOLDER_TWILIO_FROM_NUMBER

# --- JWT ---
# Any long random string works for local/dev use (e.g. `openssl rand -base64 64`).
# Every team member must use the SAME secret, or tokens issued by one instance
# will fail validation on another.
Jwt__Secret=PLACEHOLDER_JWT_SIGNING_SECRET

# --- Google OAuth (External Login) ---
# Create credentials at console.cloud.google.com/apis/credentials
# (OAuth 2.0 Client ID, type "Web application").
Authentication__Google__ClientId=PLACEHOLDER_GOOGLE_CLIENT_ID
Authentication__Google__ClientSecret=PLACEHOLDER_GOOGLE_CLIENT_SECRET

# --- Database ---
# Overrides ConnectionStrings:DefaultConnection from appsettings.json.
ConnectionStrings__DefaultConnection=PLACEHOLDER_SQL_CONNECTION_STRING
