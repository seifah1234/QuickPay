@@ -0,0 +1,50 @@
+@using QuickPay.BLL.DTOs.SharedWallet
+@model IEnumerable<SharedWalletDto>
+
+@{
+    ViewData["Title"] = "Shared Wallets";
+}
+
+<div class="container py-5">
+    <div class="row justify-content-center">
+        <div class="col-md-8">
+
+            @if (TempData["SuccessMessage"] is not null)
+            {
+                <div class="alert alert-success">@TempData["SuccessMessage"]</div>
+            }
+            @if (TempData["ErrorMessage"] is not null)
+            {
+                <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
+            }
+
+            <div class="d-flex justify-content-between align-items-center mb-4">
+                <h2 class="mb-0">Shared Wallets</h2>
+                <a asp-action="Create" class="btn btn-primary">+ New Shared Wallet</a>
+            </div>
+
+            @if (!Model.Any())
+            {
+                <p class="text-muted">You're not part of any shared wallet yet.</p>
+            }
+
+            @foreach (var sharedWallet in Model)
+            {
+                <a asp-action="Details" asp-route-id="@sharedWallet.Id" class="text-decoration-none text-body">
+                    <div class="card shadow-sm mb-3">
+                        <div class="card-body p-4 d-flex justify-content-between align-items-center">
+                            <div>
+                                <h5 class="mb-1">@sharedWallet.Name</h5>
+                                <span class="text-muted small">@sharedWallet.Members.Count() member(s)</span>
+                            </div>
+                            <div class="fs-5">
+                                @sharedWallet.Balance.ToString("N2") <span class="text-muted fs-6">@sharedWallet.Currency</span>
+                            </div>
+                        </div>
+                    </div>
+                </a>
+            }
+
+        </div>
+    </div>
+</div>
